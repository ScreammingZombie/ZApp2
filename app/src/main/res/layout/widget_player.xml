<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/w_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <!-- top: Banda - año - disco, on a darker see-through strip -->
    <TextView
        android:id="@+id/w_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#8C000000"
        android:ellipsize="end"
        android:maxLines="2"
        android:padding="8dp"
        android:text="Zombie Music Library"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- bottom: song name and the four buttons, also on a see-through strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#8C000000"
        android:orientation="vertical"
        android:paddingLeft="4dp"
        android:paddingTop="6dp"
        android:paddingRight="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:maxLines="2"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:text="Tocá play para empezar"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/w_prev"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Retroceder"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_w_prev" />

            <ImageButton
                android:id="@+id/w_play"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Play y pausa"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_w_play" />

            <ImageButton
                android:id="@+id/w_stop"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Detener"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_w_stop" />

            <ImageButton
                android:id="@+id/w_next"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Adelantar"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_w_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
